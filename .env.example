# --- General ---
ENVIRONMENT=development

# --- Postgres ---
POSTGRES_USER=civicpulse
POSTGRES_PASSWORD=changeme
POSTGRES_DB=civicpulse
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://civicpulse:changeme@postgres:5432/civicpulse

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# --- Triage provider ---
# one of: llm | ollama | rules | simulated
TRIAGE_PROVIDER=simulated

# --- Groq (if TRIAGE_PROVIDER=llm) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# --- Rate limiting ---
RATE_LIMIT_PER_MINUTE=20

# --- Frontend (runtime-injected, see ADR-0002) ---
VITE_API_BASE_URL=/api